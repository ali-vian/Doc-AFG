    trs_schedule ||--o{ trs_omzet_position : "tracks_movement"
    trs_schedule ||--o{ trs_sale : "records_live"
    trs_schedule ||--o{ trs_sale_manual : "records_manual"
    trs_schedule ||--o{ trs_accounting : "incurs_expenses"
